<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/x11_preferences">
        <EditTextPreference
            android:defaultValue="@string/x11_display"
            android:dialogTitle="@string/dialog_title_x11_display_preference"
            android:inputType="numberDecimal"
            android:key="x11_display"
            android:summary="@string/x11_display"
            android:title="@string/title_x11_display_preference" />
        <EditTextPreference
            android:defaultValue="@string/x11_host"
            android:dialogTitle="@string/dialog_title_x11_host_preference"
            android:key="x11_host"
            android:summary="@string/x11_host"
            android:title="@string/title_x11_host_preference" />
        <CheckBoxPreference
            android:defaultValue="@string/x11_sdl"
            android:key="x11_sdl"
            android:summary="@string/summary_x11_sdl_preference"
            android:title="@string/title_x11_sdl_preference" />
        <EditTextPreference
            android:defaultValue="@string/x11_sdl_delay"
            android:dependency="x11_sdl"
            android:dialogTitle="@string/dialog_title_x11_sdl_delay_preference"
            android:inputType="numberDecimal"
            android:key="x11_sdl_delay"
            android:summary="@string/x11_sdl_delay"
            android:title="@string/title_x11_sdl_delay_preference" />
        <CheckBoxPreference
            android:defaultValue="@string/native_x11"
            android:key="native_x11"
            android:summary="@string/summary_native_x11_preference"
            android:title="@string/title_native_x11_preference" />
        <CheckBoxPreference
            android:defaultValue="@string/native_gamepad"
            android:key="native_gamepad"
            android:summary="@string/summary_native_gamepad_preference"
            android:title="@string/title_native_gamepad_preference" />
        <CheckBoxPreference
            android:defaultValue="@string/native_game_mode"
            android:key="native_game_mode"
            android:summary="@string/summary_native_game_mode_preference"
            android:title="@string/title_native_game_mode_preference" />
        <ListPreference
            android:defaultValue="@string/native_desktop"
            android:dialogTitle="@string/title_native_desktop_preference"
            android:entries="@array/desktop_entries"
            android:entryValues="@array/desktop_values"
            android:key="native_desktop"
            android:summary="%s"
            android:title="@string/title_native_desktop_preference" />
        <ListPreference
            android:defaultValue="@string/gpu_vendor"
            android:dialogTitle="@string/dialog_title_gpu_vendor_preference"
            android:entries="@array/gpu_entries"
            android:entryValues="@array/gpu_values"
            android:key="gpu_vendor"
            android:summary="%s"
            android:title="@string/title_gpu_vendor_preference" />
    </PreferenceCategory>

</PreferenceScreen>